FROM onerahmet/ffmpeg:n7.1 AS ffmpeg
FROM swaggerapi/swagger-ui:v5.9.1 AS swagger-ui

# Stays on CUDA 12.6.x to match +cu126 wheels in pyproject.toml
FROM nvidia/cuda:12.6.3-base-ubuntu22.04

LABEL org.opencontainers.image.source="https://github.com/ahmetoner/whisper-asr-webservice"

ENV PYTHON_VERSION=3.10 \
    POETRY_VENV=/app/.venv \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    POETRY_NO_INTERACTION=1

# System deps
RUN export DEBIAN_FRONTEND=noninteractive \
    && apt-get -qq update \
    && apt-get -qq install --no-install-recommends \
         python${PYTHON_VERSION} python${PYTHON_VERSION}-venv python3-pip \
         ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

# Convenience symlinks
RUN ln -s -f /usr/bin/python${PYTHON_VERSION} /usr/bin/python3 && \
    ln -s -f /usr/bin/python${PYTHON_VERSION} /usr/bin/python && \
    ln -s -f /usr/bin/pip3 /usr/bin/pip

RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends ffmpeg && \
    rm -rf /var/lib/apt/lists/*

# Install Poetry in a dedicated venv
RUN python3 -m venv $POETRY_VENV \
    && $POETRY_VENV/bin/pip install -U pip setuptools \
    && $POETRY_VENV/bin/pip install poetry==2.1.3
ENV PATH="${PATH}:${POETRY_VENV}/bin"

WORKDIR /app

# ---- deps layer (no root package yet) ----
COPY pyproject.toml poetry.lock ./
RUN poetry config virtualenvs.in-project true
# install deps only (CUDA extra), skip installing the current project
RUN poetry install --only main --extras cuda --no-ansi --no-root

# Install NVIDIA CUDA runtime components (let pip pick versions compatible with torch 2.8)
RUN $POETRY_VENV/bin/pip install --no-cache-dir \
      nvidia-cuda-runtime-cu12 \
      nvidia-cublas-cu12 \
      nvidia-cudnn-cu12 \
      nvidia-cuda-nvrtc-cu12 \
      nvidia-cusolver-cu12 \
      nvidia-cusparse-cu12 \
      nvidia-curand-cu12 \
      nvidia-nvjitlink-cu12

# Make the dynamic linker see the packaged libs at runtime (no hard version pins)
ENV LD_LIBRARY_PATH="/app/.venv/lib/python3.10/site-packages/nvidia/cudnn/lib:\
/app/.venv/lib/python3.10/site-packages/nvidia/cublas/lib:\
/app/.venv/lib/python3.10/site-packages/nvidia/cuda_runtime/lib:\
/app/.venv/lib/python3.10/site-packages/nvidia/cusolver/lib:\
/app/.venv/lib/python3.10/site-packages/nvidia/cusparse/lib:\
/app/.venv/lib/python3.10/site-packages/nvidia/cuda_nvrtc/lib:\
/app/.venv/lib/python3.10/site-packages/nvidia/curand/lib:\
/app/.venv/lib/python3.10/site-packages/nvidia/nvjitlink/lib:\
${LD_LIBRARY_PATH}"


# ---- now copy the rest and install the app ----
COPY . .
COPY --from=ffmpeg /usr/local/bin/ffmpeg /usr/local/bin/ffmpeg
COPY --from=swagger-ui /usr/share/nginx/html/swagger-ui.css swagger-ui-assets/swagger-ui.css
COPY --from=swagger-ui /usr/share/nginx/html/swagger-ui-bundle.js swagger-ui-assets/swagger-ui-bundle.js

# install just the current project (gives you the console script entrypoint)
RUN poetry install --only-root --no-ansi

EXPOSE 9000
ENTRYPOINT ["whisper-asr-webservice"]
